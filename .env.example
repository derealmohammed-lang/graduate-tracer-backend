# Copy this file to .env and fill in real values before running the app.

# PostgreSQL connection
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/graduate_tracer

# JWT
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS - comma separated list of allowed origins, "*" for all (dev only)
CORS_ORIGINS=*

# App
ENVIRONMENT=development
APP_NAME=Graduate Tracer API
